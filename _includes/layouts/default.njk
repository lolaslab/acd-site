<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>{{ title }}</title>
        {#- Sharing metadata: posts use their heading, not the "ACD - …" browser title #}
        {%- set isPost = tags and "updates" in tags %}
        {%- set shareTitle = heading or title %}
        {%- set pageUrl = site.url + page.url %}
        {%- if description %}
        <meta name="description" content="{{ description | e }}">
        {%- endif %}
        <link rel="canonical" href="{{ canonical_url or pageUrl }}">
        <meta property="og:site_name" content="{{ site.name }}">
        <meta property="og:type" content="{{ 'article' if isPost else 'website' }}">
        <meta property="og:title" content="{{ shareTitle | e }}">
        <meta property="og:url" content="{{ pageUrl }}">
        {%- if description %}
        <meta property="og:description" content="{{ description | e }}">
        {%- endif %}
        {%- if isPost %}
        <meta property="article:published_time" content="{{ page.date | isoDate }}">
        {%- endif %}
        {%- if social_img %}
        {#- Images are 1200 × 630; relative paths become absolute #}
        <meta property="og:image" content="{{ social_img if '://' in social_img else site.url + social_img }}">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta property="og:image:alt" content="{{ social_img_alt | e }}">
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:image:alt" content="{{ social_img_alt | e }}">
        {%- else %}
        <meta name="twitter:card" content="summary">
        {%- endif %}
        <link rel="stylesheet" href="/css/styles.css">
        <script src="/js/terms.js" defer></script>
        <meta name="viewport" content="width=device-width, initial-scale=1">
    </head>
    <body>
        {% include "partials/_nav.njk" %}
        <main class="container">
            {{ content | safe }}
        </main>
        {% include "partials/_footer.njk" %}
    </body>
</html>
